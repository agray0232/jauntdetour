{
  "name": "frontend",
  "version": "1.3.0",
  "private": true,
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.331",
    "@vis.gl/react-google-maps": "1.5.4",
    "axios": "1.12.0",
    "loglevel": "^1.9.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.7.0",
    "react-redux": "9.2.0",
    "react-router-dom": "6.30.4",
    "react-scripts": "5.0.1",
    "redux": "5.0.1"
  },
  "scripts": {
    "start": "GENERATE_SOURCEMAP=false PORT=3001 react-scripts --openssl-legacy-provider start",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "start:test": "serve -s build -l 3001",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "eject": "react-scripts eject"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,json,css,md}": "prettier --write",
    "src/**/*.{js,jsx}": "eslint --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@playwright/test": "1.47.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest-axe": "^10.0.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.6"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(axios|@fluentui|@griffel|@swc)/)"
    ]
  }
}
